# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Google Gemini (default AI provider)
GOOGLE_AI_API_KEY=your-gemini-api-key

# OpenAI (alternate AI provider)
OPENAI_API_KEY=your-openai-api-key

# Self-hosted Qwen VL (optional — document extraction only)
# When both QWEN_BASE_URL and QWEN_MODEL are set, receipt/bill extraction
# tries this endpoint first and falls back to the cloud provider on failure.
# Ollama:    QWEN_BASE_URL=http://localhost:11434/v1
# LM Studio: QWEN_BASE_URL=http://localhost:1234/v1
QWEN_BASE_URL=
QWEN_MODEL=
QWEN_API_KEY=
QWEN_TIMEOUT_MS=45000
